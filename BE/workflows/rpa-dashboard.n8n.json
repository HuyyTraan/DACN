{
    "name": "Omni Studio · Daily dashboard screenshot",
    "active": false,
    "nodes": [
        {
            "id": "schedule",
            "name": "Daily 08:00",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [240, 300],
            "parameters": {
                "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] }
            }
        },
        {
            "id": "queue",
            "name": "Queue Playwright screenshot",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [500, 300],
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO studio_rpa_runs(kind,status,scheduled_on) VALUES('dashboard_screenshot','queued',(now() AT TIME ZONE 'Asia/Ho_Chi_Minh')::date) ON CONFLICT DO NOTHING RETURNING id"
            }
        }
    ],
    "connections": {
        "Daily 08:00": {
            "main": [[{ "node": "Queue Playwright screenshot", "type": "main", "index": 0 }]]
        }
    },
    "settings": { "executionOrder": "v1", "timezone": "Asia/Ho_Chi_Minh" },
    "pinData": {}
}
