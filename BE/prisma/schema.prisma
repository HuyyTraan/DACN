  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model publishing_deliveries {
  id                      String                    @id @db.Uuid
  plan_id                 String                    @db.Uuid
  account_id              String
  item_index              Int
  occurrence              Int                       @default(0)
  due_at                  DateTime                  @db.Timestamptz(6)
  status                  String                    @default("queued")
  provider_post_id        String?
  error                   String?
  started_at              DateTime?                 @db.Timestamptz(6)
  finished_at             DateTime?                 @db.Timestamptz(6)
  plan_version            Int                       @default(1)
  publishing_plans        publishing_plans          @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studio_delivery_history studio_delivery_history[]

  @@unique([plan_id, account_id, item_index, occurrence, plan_version], map: "publishing_delivery_revision")
  @@index([plan_id], map: "publishing_plan_deliveries")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model publishing_plans {
  id                                                     String                  @id @db.Uuid
  version                                                Int                     @default(1)
  payload                                                Json
  status                                                 String
  created_at                                             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime                @default(now()) @db.Timestamptz(6)
  created_by                                             String?                 @db.Uuid
  updated_by                                             String?                 @db.Uuid
  publishing_deliveries                                  publishing_deliveries[]
  studio_users_publishing_plans_created_byTostudio_users studio_users?           @relation("publishing_plans_created_byTostudio_users", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studio_users_publishing_plans_updated_byTostudio_users studio_users?           @relation("publishing_plans_updated_byTostudio_users", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studio_plan_history                                    studio_plan_history[]

  @@index([created_by], map: "publishing_plans_creator")
  @@index([updated_by], map: "publishing_plans_updater")
}

