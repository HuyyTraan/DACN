{
    "info": {
        "name": "Omni Studio · Local API",
        "description": "Health và workspace là read-only. Request đăng Facebook thật không nằm trong collection để tránh đăng nhầm khi chạy Collection Runner. Dùng Swagger và duyệt nội dung trước khi gọi endpoint publish.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "accountId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
