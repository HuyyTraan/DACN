        {
            "name": "Health",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/health"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Server available', () => pm.response.to.have.status(200));",
                            "pm.test('Health payload', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Workspace",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/workspace"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Workspace available', () => pm.response.to.have.status(200));",
                            "pm.test('Storage mode', () => pm.expect(['demo', 'postgres']).to.include(pm.response.json().mode));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "OpenAPI schema",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/openapi.json"
            }
        },
        {
            "name": "Facebook validation (không đăng)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"noiDungBaiViet\":\"\"}"
                },
                "url": "{{baseUrl}}/api/publish/facebook"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Empty content rejected', () => pm.response.to.have.status(400));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Connected social accounts",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/social/accounts"
            },
            "response": []
        },
        {
            "name": "Posts on connected Page",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/social/accounts/{{accountId}}/posts"
            },
            "response": []
        },
        {
            "name": "Publishing plans",
            "description": "Editor chỉ được gửi hoặc sửa pending khi giờ đăng còn cách hiện tại ít nhất 60 phút; gần hơn trả 403. Admin/Manager duyệt và lên lịch. Bản nháp không bị giới hạn 60 phút.",
            "item": [
                {
                    "name": "Publishing readiness",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/publishing/status"
                    }
                },
                {
                    "name": "List publishing plans",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/publishing/plans?limit=50&offset=0"
                    }
                },
                {
                    "name": "Create draft plan (does not publish)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/publishing/plans",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Bản soạn\",\n  \"status\": \"draft\",\n  \"accountIds\": [],\n  \"items\": [\n    {\n      \"content\": \"Nội dung thử lưu nháp\",\n      \"kind\": \"post\",\n      \"delayMinutes\": 0\n    }\n  ],\n  \"timezone\": \"Asia/Ho_Chi_Minh\",\n  \"repeat\": \"none\",\n  \"repeatCount\": 1,\n  \"scheduledAt\": \"2099-01-01T02:00:00Z\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Approval workflow",
            "description": "Chỉ chạy từng request có chủ đích trên DB local. Không chạy toàn collection; approve có thể tạo hàng đợi đăng nếu worker được bật.",
            "item": [
                {
                    "name": "Approve pending plan (Admin/Manager)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-CSRF-Token",
                                "value": "{{csrfToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"version\": 1 }"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/publishing/plans/{{planId}}/approve",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "publishing", "plans", "{{planId}}", "approve"]
                        }
                    }
                },
                {
                    "name": "Publish approved delivery now (sends to Facebook)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
                        ],
                        "body": { "mode": "raw", "raw": "{ \"version\": 1 }" },
                        "url": "{{baseUrl}}/api/publishing/plans/{{planId}}/deliveries/{{deliveryId}}/publish-now"
                    }
                }
            ]
        },
        {
            "name": "Automation (read-only)",
            "item": [
                {
                    "name": "Automation status",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/automation/status",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "automation", "status"]
                        }
                    }
                }
            ]
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "const header = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('omni_csrf='));",
                    "if (header) pm.collectionVariables.set('csrf', header.value.split(';')[0].split('=')[1]);"
                ]
            }
        }
    ]
}
