PORT=3000
HOST=127.0.0.1
# Để trống DATABASE_URL để dùng demo localStorage.
DATABASE_URL=
# Sau docker compose up -d, có thể dùng:
# DATABASE_URL=postgresql://omni:omni_local_dev@localhost:5432/omni
PAGE_ID=
PAGE_ACCESS_TOKEN=
# Facebook Login: App Secret giữ riêng ở backend, không dùng biến VITE_.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Trùng chính xác URL callback được đăng ký trong ứng dụng Meta.
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/social/facebook/callback
# Threads OAuth chỉ nhận callback HTTPS không dùng localhost; điền URL tunnel HTTPS đang hoạt động.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# Dùng URL FE khi phát triển với Vite; bản build cùng BE dùng localhost:3000.
SOCIAL_UI_ORIGIN=http://localhost:5173
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Instagram local development can use a temporary Cloudflare Quick Tunnel
# (install cloudflared; set INSTAGRAM_MEDIA_TUNNEL_ENABLED=false to disable).
# For persistent hosting, configure an S3-compatible public bucket instead.
INSTAGRAM_MEDIA_TUNNEL_ENABLED=true
# S3-compatible public media bucket for Instagram (Cloudflare R2/AWS S3).
# The public origin must serve uploaded objects without authentication so Meta can fetch them.
INSTAGRAM_MEDIA_ENDPOINT=
INSTAGRAM_MEDIA_REGION=auto
INSTAGRAM_MEDIA_BUCKET=
INSTAGRAM_MEDIA_ACCESS_KEY=
INSTAGRAM_MEDIA_SECRET_KEY=
INSTAGRAM_MEDIA_PUBLIC_ORIGIN=
# Giữ phiên bản đang dùng trong dự án; kiểm tra Meta trước khi nâng phiên bản.
GRAPH_API_VERSION=v21.0
# Chỉ dùng mật khẩu mẫu cho phát triển local.
POSTGRES_PASSWORD=omni_local_dev
N8N_ENCRYPTION_KEY=replace_with_a_long_random_key_before_starting_n8n
# Worker riêng, mặc định tắt. true + npm run worker:publishing sẽ đăng thật các job đến hạn.
PUBLISHING_WORKER_ENABLED=false
# Tài khoản ứng dụng riêng cho Playwright RPA; nên dùng Viewer chỉ đọc.
# Không cần hai biến này khi chỉ chạy thử bằng nút trong UI.
RPA_EMAIL=
RPA_PASSWORD=
# Origin UI trên chính máy worker (Vite 5173 khi dev, hoặc Express 3000 sau build).
RPA_BASE_URL=http://127.0.0.1:5173
# AI Analysis dùng Gemini qua backend. Dùng key của project Free Tier, chưa liên kết billing.
# Chế độ mặc định chỉ cho phép gemini-2.5-flash-lite; kiểm tra Billing Tier trong AI Studio.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash-lite
AI_GEMINI_FREE_TIER_ONLY=true
AI_DAILY_REQUEST_LIMIT=10
# Chỉ dùng 3 biến sau nếu chủ động đặt AI_GEMINI_FREE_TIER_ONLY=false và kiểm tra giá hiện hành.
AI_DAILY_BUDGET_VND=
AI_INPUT_PRICE_VND_PER_MILLION_TOKENS=
AI_OUTPUT_PRICE_VND_PER_MILLION_TOKENS=
AI_MAX_INPUT_TOKENS=200000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=20000
# Secure cookies require HTTPS in production; local HTTP uses development.
NODE_ENV=development
# Optional pg_dump path for npm run db:backup (Windows default PostgreSQL 18).
PG_DUMP_PATH=
